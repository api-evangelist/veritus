            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the customer to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing customer's information. All fields are optional - only provide the fields you want to update."
        },
        {
          "info": {
            "name": "POST /customers/{customerId}/drip-campaigns",
            "type": "http"
